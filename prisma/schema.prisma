// JobConnect database schema – see docs/05-design/01-data-model.md.
// Tables are added story by story; each change gets its own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles a user can have (docs/05-design/01-data-model.md §3.1). Also copied onto audit entries.
enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN

  @@map("user_role")
}

/// Account status (BR §1). "Unverified" is not a status: it is `emailVerified = false`,
/// so there is one source of truth for verification (Better Auth owns that flag).
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// Better Auth core user + JobConnect fields (docs/05-design/01-data-model.md §3.1). Field names follow Better Auth.
model User {
  id                   String     @id @db.Uuid
  name                 String
  email                String     @unique @db.Citext
  emailVerified        Boolean    @default(false) @map("email_verified")
  image                String?
  role                 UserRole
  status               UserStatus @default(ACTIVE)
  /// Required when SUSPENDED (FR-ADM-006) – CHECK in migration.
  statusReason         String?    @map("status_reason")
  privacyConsentAt     DateTime   @map("privacy_consent_at") @db.Timestamptz(3)
  privacyPolicyVersion String     @map("privacy_policy_version")
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  accounts         Account[]
  company          Company?
  candidateProfile CandidateProfile?

  @@index([role, status])
  @@map("user")
}

/// Login sessions; the cookie holds only the opaque token (NFR-SEC-006).
model Session {
  id        String   @id @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Credentials. For email + password, `password` is the Argon2id hash (NFR-SEC-001).
model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

/// Email-verification and password-reset tokens with expiry (FR-AUTH-005/008).
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// Rate-limit counters in the database, so limits hold across instances (NFR-SEC-007).
model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

/// Industries for companies and jobs (FR-ADM-014). Deactivated, never deleted (docs/05-design/01-data-model.md §3.4).
model Industry {
  id        String   @id @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies Company[]
  jobs      Job[]

  @@map("industry")
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_500_PLUS

  @@map("company_size")
}

/// Company verification lifecycle (BR §2).
enum CompanyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("company_status")
}

/// One company per employer in this release (FR-EMP-005 is Won't) – docs/05-design/01-data-model.md §3.5.
model Company {
  id                 String        @id @db.Uuid
  /// NULL only after the owner's account is erased (BR-USR-004).
  ownerUserId        String?       @unique @map("owner_user_id") @db.Uuid
  name               String
  description        String
  industryId         String        @map("industry_id") @db.Uuid
  size               CompanySize
  website            String?
  location           String
  logoKey            String?       @map("logo_key")
  verificationStatus CompanyStatus @default(PENDING) @map("verification_status")
  /// Shown to the employer; required when REJECTED or SUSPENDED (BR-CMP-002) – CHECK.
  statusReason       String?       @map("status_reason")
  submittedAt        DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(3)
  verifiedAt         DateTime?     @map("verified_at") @db.Timestamptz(3)
  /// Admin who verified it (also in the audit log). No FK: survives admin deletion.
  verifiedBy         String?       @map("verified_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)
  jobs     Job[]

  @@index([verificationStatus, submittedAt])
  @@map("company")
}

/// Job lifecycle (BR §3).
enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  PAUSED
  REJECTED
  CLOSED
  REMOVED

  @@map("job_status")
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE

  @@map("work_mode")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP

  @@map("job_type")
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD

  @@map("experience_level")
}

enum SalaryPeriod {
  YEAR
  DAY
  HOUR

  @@map("salary_period")
}

/// A job advert (docs/05-design/01-data-model.md §3.6). Only PUBLISHED jobs of verified companies are visible (BR-JOB-001).
model Job {
  id              String                   @id @db.Uuid
  companyId       String                   @map("company_id") @db.Uuid
  title           String
  description     String
  requirements    String
  /// NULL only for REMOTE jobs (BR-JOB-010) – CHECK.
  location        String?
  workMode        WorkMode                 @map("work_mode")
  jobType         JobType                  @map("job_type")
  experienceLevel ExperienceLevel          @map("experience_level")
  industryId      String                   @map("industry_id") @db.Uuid
  /// Whole pounds; min <= max (BR-JOB-003) – CHECK.
  salaryMin       Int                      @map("salary_min")
  salaryMax       Int                      @map("salary_max")
  salaryPeriod    SalaryPeriod             @default(YEAR) @map("salary_period")
  currency        String                   @default("GBP") @db.Char(3)
  /// End of the closing day (23:59:59 UTC). 1–90 days ahead at submit (BR-JOB-002, checked in code).
  deadline        DateTime                 @db.Timestamptz(3)
  status          JobStatus                @default(DRAFT)
  /// Shown to the employer; required when REJECTED or REMOVED (BR-JOB-008) – CHECK.
  statusReason    String?                  @map("status_reason")
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz(3)
  publishedAt     DateTime?                @map("published_at") @db.Timestamptz(3)
  closedAt        DateTime?                @map("closed_at") @db.Timestamptz(3)
  /// Full-text search document, GENERATED ALWAYS … STORED in the database (migration
  /// …_job_search_vector): title (A), requirements (B), description (C). Never written by the app.
  searchVector    Unsupported("tsvector")? @default(dbgenerated("job_search_document(title, requirements, description)")) @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  industry     Industry      @relation(fields: [industryId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("job")
}

/// A candidate's profile (docs/05-design/01-data-model.md §3.2). Deleted with the user.
model CandidateProfile {
  userId    String   @id @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  headline  String?
  location  String?
  /// Shown to employers only from SHORTLISTED onward (BR-APP-010, sprint S4).
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvs          Cv[]
  applications Application[]

  @@map("candidate_profile")
}

/// Malware scan state (NFR-SEC-009 – scanner arrives in Release 1.0; MVP writes SKIPPED).
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED

  @@map("scan_status")
}

/// An uploaded CV (FR-CAN-005): max 5 per candidate, PDF/DOCX by content, ≤ 5 MB – CHECKs.
/// The file lives in private object storage under a random key; never served directly.
model Cv {
  id               String     @id @db.Uuid
  candidateId      String     @map("candidate_id") @db.Uuid
  storageKey       String     @unique @map("storage_key")
  originalFilename String     @map("original_filename")
  mimeType         String     @map("mime_type")
  sizeBytes        Int        @map("size_bytes")
  scanStatus       ScanStatus @default(SKIPPED) @map("scan_status")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidate CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Cascade)

  @@index([candidateId, createdAt(sort: Desc)])
  @@map("cv")
}

/// Application lifecycle (BR §4).
enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN

  @@map("application_status")
}

/// One candidate's application to one job (docs/05-design/01-data-model.md §3.7).
/// UNIQUE (job_id, candidate_id): once per job, ever (BR-APP-002). The CV is a snapshot copy (BR-APP-003).
model Application {
  id                 String            @id @db.Uuid
  jobId              String            @map("job_id") @db.Uuid
  /// NULL after anonymisation (BR-USR-003, BR-APP-009).
  candidateId        String?           @map("candidate_id") @db.Uuid
  cvStorageKey       String?           @map("cv_storage_key")
  cvOriginalFilename String?           @map("cv_original_filename")
  cvMimeType         String?           @map("cv_mime_type")
  cvSizeBytes        Int?              @map("cv_size_bytes")
  coverLetter        String?           @map("cover_letter")
  status             ApplicationStatus @default(APPLIED)
  appliedAt          DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)
  anonymisedAt       DateTime?         @map("anonymised_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  job       Job                        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate CandidateProfile?          @relation(fields: [candidateId], references: [userId], onDelete: SetNull)
  history   ApplicationStatusHistory[]

  @@unique([jobId, candidateId])
  @@index([candidateId, appliedAt(sort: Desc)])
  @@index([jobId, appliedAt(sort: Desc)])
  @@map("application")
}

/// Every status change of an application (BR-APP-007).
model ApplicationStatusHistory {
  id              String             @id @db.Uuid
  applicationId   String             @map("application_id") @db.Uuid
  fromStatus      ApplicationStatus? @map("from_status")
  toStatus        ApplicationStatus  @map("to_status")
  /// No FK: survives the user's erasure.
  changedByUserId String?            @map("changed_by_user_id") @db.Uuid
  /// Optional rejection message shown to the candidate (FR-EMP-018).
  message         String?
  changedAt       DateTime           @default(now()) @map("changed_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
  @@map("application_status_history")
}

/// Append-only record of admin actions and security events (FR-ADM-019/021, docs/05-design/01-data-model.md §3.10).
/// No foreign keys on purpose: entries must survive user deletion and are never updated.
/// The database rejects UPDATE/TRUNCATE, and DELETE of entries younger than 24 months
/// (BR-AUD-001) – see the migration's triggers.
model AuditLog {
  id          BigInt    @id @default(autoincrement())
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorRole   UserRole? @map("actor_role")
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id") @db.Uuid
  ipAddress   String?   @map("ip_address") @db.Inet
  requestId   String?   @map("request_id")
  /// Reasons and old/new statuses only – never names, emails or CV content (NFR-PRV-004).
  metadata    Json      @default("{}")

  @@index([occurredAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("audit_log")
}
