# Copy to .env.local for local development. Never commit real secrets (NFR-SEC-010).
DATABASE_URL="postgresql://jobconnect:jobconnect@localhost:5432/jobconnect"

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Email. Locally this is Mailpit (npm run db:up); inbox at http://localhost:8025
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="JobConnect <no-reply@jobconnect.local>"

# Breached-password check (FR-AUTH-003). Sends only a 5-character hash prefix.
HIBP_ENABLED="true"
